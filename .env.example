DB_USER=admin
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=cassie_db
DB_HOST_PORT=5433

MINIO_ROOT_USER=replace-with-a-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-storage-secret
MINIO_REGION=us-east-1
MINIO_BUCKET_PREFIX=cassie
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=http://localhost:9010
MINIO_PUBLIC_ENDPOINT=http://localhost:9010
DEFAULT_MAX_USER_STORAGE_GB=35
MIN_FREE_STORAGE_GB=5
CASSIE_MAX_CLOUD_IMPORT_BYTES=5368709120

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
CASSIE_ALLOW_DEV_CODE_PREVIEW=false
CASSIE_ENABLE_FAKE_PAYMENTS=false
CASSIE_LOCAL_LLM_BASE_URL=http://localhost:11434
CASSIE_LOCAL_LLM_MODEL=local-model
CASSIE_LOCAL_LLM_TIMEOUT_SECONDS=25

EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=CASSIE
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

EXECUTION_BACKEND=kubernetes
KUBERNETES_NAMESPACE=default
KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
KUBERNETES_JOB_TIMEOUT_SECONDS=0
KUBERNETES_POLL_INTERVAL_SECONDS=5
KUBERNETES_CLUSTER_CHECK_TIMEOUT_SECONDS=60
KUBERNETES_AVAILABILITY_CHECK_TIMEOUT_SECONDS=5
CASSIE_DOCKER_RETRY_ATTEMPTS=3
CASSIE_DOCKER_RETRY_DELAY_SECONDS=5
CASSIE_BACKEND_BASE_IMAGE=python:3.12-slim
CASSIE_FRONTEND_BUILD_BASE_IMAGE=node:20-alpine
CASSIE_FRONTEND_NGINX_BASE_IMAGE=nginx:1.27-alpine
CASSIE_POSTGRES_IMAGE=postgres:15
CASSIE_MINIO_IMAGE=minio/minio:RELEASE.2025-02-28T09-55-16Z
CASSIE_KUBECTL_VERSION=v1.35.1
KUBERNETES_MINIO_ENDPOINT=http://host.docker.internal:9010
KUBERNETES_NO_PROXY=localhost,127.0.0.1,host.docker.internal,kubernetes.docker.internal
KUBE_CONFIG_DIR=C:/Users/<YourUser>/.kube

VITE_API_URL=http://localhost:8000
VITE_GENERAL_ACCESS_PASSWORD=replace-with-general-access-code
VITE_GOOGLE_DRIVE_CLIENT_ID=88053759381-4aohq713mr7vpcfrv3mn37q30eop22pj.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_API_KEY=your-browser-restricted-google-drive-api-key
VITE_GOOGLE_DRIVE_APP_ID=88053759381
DOCKER_SOCK_PATH=/var/run/docker.sock
