DB_USER=admin
DB_PASSWORD=admin
DB_NAME=cassie_db
DB_HOST_PORT=5433

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_PREFIX=cassie
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=http://localhost:9010
MINIO_PUBLIC_ENDPOINT=http://localhost:9010

JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

EXECUTION_BACKEND=kubernetes
KUBERNETES_NAMESPACE=default
KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
KUBERNETES_JOB_TIMEOUT_SECONDS=3600
KUBERNETES_POLL_INTERVAL_SECONDS=5
KUBERNETES_MINIO_ENDPOINT=http://host.docker.internal:9010
KUBERNETES_NO_PROXY=localhost,127.0.0.1,host.docker.internal,kubernetes.docker.internal
KUBE_CONFIG_DIR=C:/Users/<YourUser>/.kube

VITE_API_URL=http://localhost:8000
DOCKER_SOCK_PATH=/var/run/docker.sock
