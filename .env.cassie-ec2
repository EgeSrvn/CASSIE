DB_USER=cassie
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_NAME=cassie_db
DB_HOST_PORT=5433

# AWS S3 mode:
# Leave both endpoint values blank so the backend uses native AWS S3.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_REGION=us-east-1
MINIO_BUCKET_PREFIX=cassie-prod-REPLACE_WITH_REAL_BUCKET

# Intentionally omitted for future IAM-role-based EC2 deployment:
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

DEFAULT_MAX_USER_STORAGE_GB=35
MIN_FREE_STORAGE_GB=5

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=https://cassie.example.com

EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=CASSIE
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

EXECUTION_BACKEND=kubernetes
KUBERNETES_NAMESPACE=default
KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
KUBERNETES_JOB_TIMEOUT_SECONDS=0
KUBERNETES_POLL_INTERVAL_SECONDS=5
KUBERNETES_MINIO_ENDPOINT=
KUBERNETES_NO_PROXY=localhost,127.0.0.1,host.docker.internal,kubernetes.docker.internal
KUBE_CONFIG_DIR=/opt/CASSIE/.cassie/kube

CASSIE_MINIKUBE_CPUS=4
CASSIE_MINIKUBE_MEMORY=7800
CASSIE_MINIKUBE_DISK_SIZE=40g
CASSIE_DOCKER_RETRY_ATTEMPTS=3
CASSIE_DOCKER_RETRY_DELAY_SECONDS=5
CASSIE_CLUSTER_STORAGE_RESERVE_MIB=2048

CASSIE_BACKEND_BASE_IMAGE=python:3.12-slim
CASSIE_FRONTEND_BUILD_BASE_IMAGE=node:20-alpine
CASSIE_FRONTEND_NGINX_BASE_IMAGE=nginx:1.27-alpine
CASSIE_POSTGRES_IMAGE=postgres:15
CASSIE_KUBECTL_VERSION=v1.35.1

FASTQC_THREADS=auto
GENOMESCOPE2_THREADS=auto
SPADES_THREADS=auto
SPADES_MEMORY_GB=auto
SPADES_LOW_RESOURCE=auto
SPADES_KMERS=auto
SPADES_MEMORY_LIMIT=auto
METASPADES_THREADS=auto
METASPADES_MEMORY_GB=auto
HIFIASM_THREADS=auto
HIFIASM_MEMORY_GB=auto
VERKKO_THREADS=auto
VERKKO_MEMORY_GB=auto
LIFTOFF_THREADS=auto
CAT_THREADS=auto
CAT_MEMORY_GB=auto
BUSCO_THREADS=auto
BUSCO_MEMORY_GB=auto
MERQURY_THREADS=auto
MERQURY_MEMORY_GB=auto
QUAST_THREADS=auto

VITE_API_URL=
VITE_GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_DRIVE_CLIENT_ID
VITE_GOOGLE_DRIVE_API_KEY=YOUR_GOOGLE_DRIVE_API_KEY
VITE_GOOGLE_DRIVE_APP_ID=YOUR_GOOGLE_DRIVE_APP_ID

DOCKER_SOCK_PATH=/var/run/docker.sock

# Important:
# This file is intended for the future EC2 migration where CASSIE uses an EC2 IAM role
# for AWS S3 access instead of explicit MINIO_ACCESS_KEY / MINIO_SECRET_KEY values.
# With the current codebase, backend S3 access can use the AWS credential chain,
# but Kubernetes stage input-download setup still expects explicit credentials for full job execution.
